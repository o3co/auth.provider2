{
	"name": "@mod/transparency-local",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"adapts": "@mod/transparency",
	"neverDefault": true,
	"asks": [
		"Not recommended: `core-compromise-contained` does not hold, as the log and the judgment of its records run in the Core. The way out is an adapter of the axis with its log and monitor outside the Core, the keys held now brought over once as first-trust records and every user logging in again."
	],
	"exports": {
		".": "./src/contract.ts",
		"./module": "./src/module.ts"
	},
	"dependencies": {
		"@mod/authority-rules": "workspace:*",
		"@mod/kernel": "workspace:*",
		"@mod/keys": "workspace:*",
		"@mod/passkeys": "workspace:*",
		"@mod/promises": "workspace:*",
		"@mod/records": "workspace:*",
		"@mod/reset-wire": "workspace:*",
		"@mod/store": "workspace:*",
		"@mod/transparency": "workspace:*",
		"@mod/transparency-wire": "workspace:*",
		"@mod/webauthn": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/continuation-wire": "workspace:*",
		"@mod/sdk-core-wire": "workspace:*",
		"vitest": "5.0.5"
	}
}
