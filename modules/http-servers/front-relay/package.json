{
	"name": "@mod/front-relay",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"adapts": "@mod/http",
	"asks": [
		"`front-relay`: the Core's entrance (`core-host`, `core-port`), this Front instance's certificate and key (`certificate-file`, `key-file`) and the authorities the Core's certificate chains to (`core-authority-file`), PEM files read at each connection."
	],
	"network": "wire",
	"permissions": {
		"read": {
			"keys": [
				"certificate-file",
				"key-file",
				"core-authority-file"
			]
		}
	},
	"exports": {
		"./module": "./src/module.ts",
		"./testing": "./src/testing.ts"
	},
	"dependencies": {
		"@mod/front-core-codec": "workspace:*",
		"@mod/front-core-wire": "workspace:*",
		"@mod/http": "workspace:*",
		"@mod/http-server": "workspace:*",
		"@mod/kernel": "workspace:*",
		"@mod/tls-options": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/http-ops": "workspace:*",
		"vitest": "5.0.5"
	}
}
