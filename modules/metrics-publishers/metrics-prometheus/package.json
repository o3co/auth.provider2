{
	"name": "@mod/metrics-prometheus",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"adapts": "@mod/metrics",
	"default": true,
	"joins": [
		"@mod/http",
		"@mod/metrics"
	],
	"permissions": {
		"read": {
			"paths": [
				{
					"path": "/proc/self/limits",
					"kind": "file"
				},
				{
					"path": "/proc/self/status",
					"kind": "file"
				},
				{
					"path": "/proc/self/fd",
					"kind": "dir"
				}
			]
		}
	},
	"exports": {
		"./module": "./src/module.ts"
	},
	"dependencies": {
		"@mod/http": "workspace:*",
		"@mod/kernel": "workspace:*",
		"@mod/metrics": "workspace:*",
		"prom-client": "15.1.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/http-server": "workspace:*",
		"vitest": "5.0.5"
	}
}
