{
	"name": "@mod/keys-kms",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"kind": "adapter",
	"adapts": "@mod/keys",
	"asks": [
		"Keys held in KMS (`keys-kms.region`, and each kid's key in `keys-kms.keys`: its ARN, id or alias): the keys' specs and usages, and the Core role's permissions, as its card's Deployment states them."
	],
	"default": true,
	"network": "kms",
	"permissions": {
		"read": {
			"env": [
				{
					"name": "AWS_CONFIG_FILE",
					"default": "~/.aws/config",
					"home": true
				},
				{
					"name": "AWS_SHARED_CREDENTIALS_FILE",
					"default": "~/.aws/credentials",
					"home": true
				},
				{
					"name": "AWS_WEB_IDENTITY_TOKEN_FILE"
				},
				{
					"name": "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE"
				}
			]
		}
	},
	"exports": {
		"./module": "./src/module.ts",
		"./testing": "./src/testing.ts"
	},
	"dependencies": {
		"@aws-sdk/client-kms": "3.1174.0",
		"@mod/kernel": "workspace:*",
		"@mod/keys": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@mod/sdk-core-wire": "workspace:*",
		"jose": "6.2.15",
		"vitest": "5.0.5"
	}
}
