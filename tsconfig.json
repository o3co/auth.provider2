{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	// The patterns follow the workspace definition.
	"include": [
		"*.config.ts",
		"modules/*/*/src/**/*.ts",
		"modules/*/*/test/**/*.ts",
		"modules/*/*/*.config.ts"
	],
	// The attack harness's tests read the login screen's SDK, typed with the DOM: `tsconfig.attacks.json`.
	"exclude": ["modules/attacks/*/test/**", "modules/attacks/*/src/**/test/**"]
}
